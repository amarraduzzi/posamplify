# Supabase project (Settings > API). The anon key is public by design:
# the database rules decide what it can do.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_... (Settings > API Keys > Publishable key)
# Domain whose subdomains are restaurants (doms-cafe.<domain>). Leave empty
# to use path mode (<host>/doms-cafe/t/<token>), e.g. on *.pages.dev.
VITE_ROOT_DOMAIN=
# Only when the product pages live on the company site: the old landing pages (/, /profit, /fonctionnalites)
# redirect there. Restaurant menus are never redirected. Example: https://amplifygrowthstudio.com
VITE_MARKETING_URL=
